{
  "name": "@crossverse/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Application mobile Expo (React Native) de Crossverse : présentation uniquement, aucune solution.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crossverse/contracts": "workspace:*",
    "@crossverse/crossword-core": "workspace:*",
    "@expo/metro-runtime": "58.0.14",
    "expo": "58.0.16",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.13",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
