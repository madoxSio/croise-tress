# Copier vers .env (fait par `make init` si .env n'existe pas). Aucune valeur réelle ici :
# ces valeurs ne servent qu'au développement local.

# --- PostgreSQL ---
POSTGRES_USER=crossverse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=crossverse
# Port publié sur 127.0.0.1 uniquement
POSTGRES_PORT=5432
# Utilisée par l'API et Prisma quand ils tournent hors Docker (dans Docker, l'hôte devient `postgres`).
DATABASE_URL=postgresql://crossverse:change-me-local-only@127.0.0.1:5432/crossverse

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Origines autorisées pour les requêtes mutantes (séparées par des virgules).
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# --- Web ---
WEB_PORT=3000

# --- E-mails (Mailpit en développement) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Crossverse <no-reply@crossverse.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
