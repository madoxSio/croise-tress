# Copier vers .env.prod sur le serveur et remplacer CHAQUE valeur. Ne jamais commiter .env.prod.
# Domaine public pointant vers le serveur (DNS A/AAAA) : Caddy obtient le certificat TLS.
DOMAIN=crossverse.example.com

POSTGRES_USER=crossverse
# Mot de passe long et aléatoire, par exemple : openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=crossverse

LOG_LEVEL=info

# Version des images GHCR à déployer (latest, ou sha-<commit> pour revenir en arrière).
CROSSVERSE_VERSION=latest

# Fournisseur SMTP transactionnel (confirmation d'adresse, réinitialisation de mot de passe).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Crossverse <no-reply@crossverse.example.com>"
